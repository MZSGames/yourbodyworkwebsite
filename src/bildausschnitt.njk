{# Hilfswerkzeug für Ronja: Bildausschnitt per Klick wählen und Wert für den Editor kopieren.
   Die Seite ist nicht im Menü verlinkt und für Suchmaschinen gesperrt. #}
<section class="page-body tool-page">
  <div class="wrap">
    <p class="eyebrow">Werkzeug</p>
    <h1>Bildausschnitt wählen</h1>
    <p class="tool-intro">Hier legst du fest, welcher Teil eines Fotos sichtbar bleibt, wenn es auf der Website zugeschnitten wird. Das ist besonders wichtig bei Hochkant-Fotos und Porträts.</p>

    <div class="tool-step">
      <h2><span>1</span> Bild auswählen</h2>
      <p>Klick auf eines deiner Website-Bilder, oder wähle ein Foto von deinem Gerät aus.</p>
      <div class="tool-thumbs">
        {% for img in uploads %}
        <button type="button" class="tool-thumb" title="{{ img | replace('/images/uploads/', '') }}"><img src="{{ img }}" alt="" loading="lazy"></button>
        {% endfor %}
      </div>
      <label class="btn btn-outline tool-file">Foto vom Gerät wählen <input type="file" accept="image/*" hidden></label>
      <p class="tool-hint">Ein Foto vom Gerät wird nur hier angezeigt und nirgends hochgeladen.</p>
    </div>

    <div class="tool-step" data-needs-image hidden>
      <h2><span>2</span> Ins Bild klicken</h2>
      <p>Klick auf die Stelle, die <strong>immer sichtbar</strong> bleiben soll, z. B. das Gesicht. Du kannst den Punkt auch verschieben.</p>
      <div class="tool-stage"><img class="tool-main" alt="Ausgewähltes Bild"><span class="tool-dot" aria-hidden="true"></span></div>
    </div>

    <div class="tool-step" data-needs-image hidden>
      <h2><span>3</span> Vorschau prüfen</h2>
      <p>So ungefähr wird das Bild an den verschiedenen Stellen zugeschnitten.</p>
      <div class="tool-previews">
        <figure><div class="pv" style="aspect-ratio: 6 / 5"><img alt=""></div><figcaption>Großes Bild ganz oben (Computer)</figcaption></figure>
        <figure><div class="pv" style="aspect-ratio: 4 / 3"><img alt=""></div><figcaption>Bild neben Text &amp; Kacheln (Computer)</figcaption></figure>
        <figure><div class="pv" style="aspect-ratio: 3 / 2"><img alt=""></div><figcaption>Erfahrungsberichte (Computer)</figcaption></figure>
        <figure><div class="pv" style="aspect-ratio: 16 / 9"><img alt=""></div><figcaption>Am Handy &amp; Abschluss-Bereich</figcaption></figure>
      </div>
    </div>

    <div class="tool-step tool-result" data-needs-image hidden>
      <h2><span>4</span> Wert in den Editor übernehmen</h2>
      <p>Kopiere diesen Wert und füge ihn in Pages CMS beim passenden Bild ins Feld <strong>„Bildausschnitt“</strong> ein. Dann <strong>Speichern</strong>.</p>
      <div class="tool-value"><code data-value>50 50</code><button type="button" class="btn" data-copy>Wert kopieren</button></div>
      <p class="tool-copied" hidden>✓ Kopiert! Jetzt in Pages CMS einfügen.</p>
    </div>
  </div>
</section>

<style>
  .tool-intro { color: var(--ink-soft); max-width: 680px; }
  .tool-step { margin-top: 48px; }
  .tool-step h2 { font-size: clamp(24px, 2.4vw, 32px); display: flex; align-items: center; gap: 14px; }
  .tool-step h2 span { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--clay); color: #fff; font: 500 16px var(--sans); }
  .tool-step p { color: var(--ink-soft); }
  .tool-thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; margin: 18px 0; }
  .tool-thumb { padding: 0; border: 2px solid transparent; border-radius: calc(var(--radius) * .6); overflow: hidden; cursor: pointer; aspect-ratio: 1; background: var(--sand); }
  .tool-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .tool-thumb.is-active { border-color: var(--clay); }
  .tool-file { cursor: pointer; }
  .tool-hint { font-size: 14px; }
  .tool-stage { position: relative; display: inline-block; max-width: 100%; margin-top: 10px; cursor: crosshair; touch-action: none; user-select: none; }
  .tool-main { display: block; max-width: 100%; max-height: 70vh; border-radius: calc(var(--radius) * .6); }
  .tool-dot { position: absolute; width: 34px; height: 34px; margin: -17px 0 0 -17px; border-radius: 50%; border: 3px solid #fff; box-shadow: 0 0 0 2px var(--clay), 0 2px 10px rgba(0,0,0,.4); background: color-mix(in srgb, var(--clay) 35%, transparent); pointer-events: none; left: 50%; top: 50%; }
  .tool-previews { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 18px; align-items: end; }
  .tool-previews figure { margin: 0; }
  .tool-previews .pv { overflow: hidden; border-radius: calc(var(--radius) * .6); background: var(--sand); }
  .tool-previews img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tool-previews figcaption { font-size: 14px; color: var(--ink-soft); margin-top: 8px; }
  .tool-value { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 12px; }
  .tool-value code { font: 500 32px var(--sans); letter-spacing: .04em; padding: 10px 22px; background: var(--cream-2); border: 1px solid var(--sand); border-radius: calc(var(--radius) * .6); }
  .tool-copied { color: var(--clay); font-weight: 500; }
  @media (max-width: 980px) { .tool-previews { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .tool-previews { grid-template-columns: 1fr; } }
</style>

<script>
(() => {
  const main = document.querySelector(".tool-main");
  const stage = document.querySelector(".tool-stage");
  const dot = document.querySelector(".tool-dot");
  const previews = document.querySelectorAll(".tool-previews img");
  const valueEl = document.querySelector("[data-value]");
  const copied = document.querySelector(".tool-copied");
  let x = 50, y = 50;

  const show = (src) => {
    main.src = src;
    previews.forEach((p) => (p.src = src));
    document.querySelectorAll("[data-needs-image]").forEach((el) => (el.hidden = false));
    set(50, 50);
    stage.scrollIntoView({ behavior: "smooth", block: "center" });
  };

  const set = (nx, ny) => {
    x = Math.round(Math.min(100, Math.max(0, nx)));
    y = Math.round(Math.min(100, Math.max(0, ny)));
    dot.style.left = x + "%";
    dot.style.top = y + "%";
    previews.forEach((p) => (p.style.objectPosition = `${x}% ${y}%`));
    valueEl.textContent = `${x} ${y}`;
    copied.hidden = true;
  };

  document.querySelectorAll(".tool-thumb").forEach((b) =>
    b.addEventListener("click", () => {
      document.querySelectorAll(".tool-thumb").forEach((t) => t.classList.remove("is-active"));
      b.classList.add("is-active");
      show(b.querySelector("img").src);
    })
  );

  document.querySelector(".tool-file input").addEventListener("change", (e) => {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    document.querySelectorAll(".tool-thumb").forEach((t) => t.classList.remove("is-active"));
    show(URL.createObjectURL(file));
  });

  // Klicken oder Ziehen im Bild
  let dragging = false;
  const fromEvent = (e) => {
    const r = main.getBoundingClientRect();
    set(((e.clientX - r.left) / r.width) * 100, ((e.clientY - r.top) / r.height) * 100);
  };
  stage.addEventListener("pointerdown", (e) => { dragging = true; stage.setPointerCapture(e.pointerId); fromEvent(e); });
  stage.addEventListener("pointermove", (e) => { if (dragging) fromEvent(e); });
  stage.addEventListener("pointerup", () => (dragging = false));
  stage.addEventListener("pointercancel", () => (dragging = false));

  document.querySelector("[data-copy]").addEventListener("click", async () => {
    const text = valueEl.textContent;
    try { await navigator.clipboard.writeText(text); }
    catch {
      const r = document.createRange(); r.selectNodeContents(valueEl);
      const s = getSelection(); s.removeAllRanges(); s.addRange(r);
      document.execCommand("copy");
    }
    copied.hidden = false;
  });
})();
</script>
