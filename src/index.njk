---
layout: base.njk
bodyClass: home
---
{% set h = home %}

{# ---------- HERO ---------- #}
<section class="hero">
  <div class="hero-media">
    <img src="{{ h.hero.image }}" alt="{{ h.hero.image_alt }}" fetchpriority="high">
  </div>
  <div class="wrap hero-content">
    <p class="eyebrow">{{ h.hero.eyebrow }}</p>
    <h1>{{ h.hero.title | lines | safe }}</h1>
    <div class="lead">{{ h.hero.text | paras | safe }}</div>
    <a class="btn" href="{{ settings.contact_link }}">{{ h.hero.button_text }} {% include "arrow.njk" %}</a>
    {% if h.hero.note %}<p class="note">{{ h.hero.note }}</p>{% endif %}
  </div>
</section>

{# ---------- INTRO ---------- #}
<section class="intro">
  <div class="wrap intro-grid">
    <div class="intro-title">
      <h2>{{ h.intro.title | lines | safe }}</h2>
      <span class="rule"></span>
    </div>
    <svg class="branch" viewBox="0 0 120 200" aria-hidden="true">
      <path d="M8 196C40 150 70 100 98 6"/>
      <path d="M30 160c-14-8-20-20-18-30 12 4 18 16 18 30zM30 160c14-4 26-2 34 6-12 6-24 4-34-6z"/>
      <path d="M46 128c-14-10-18-22-14-32 12 6 16 18 14 32zM46 128c14-4 26 0 32 8-12 4-24 2-32-8z"/>
      <path d="M62 96c-12-10-16-22-12-32 12 6 14 18 12 32zM62 96c14-4 24 0 30 8-12 4-22 2-30-8z"/>
      <path d="M78 62c-10-10-12-20-8-30 10 6 12 18 8 30zM78 62c12-4 22-2 28 6-10 4-20 2-28-6z"/>
      <path d="M92 26c-6-8-6-16-2-22 8 6 8 14 2 22z"/>
    </svg>
    <div class="intro-text">
      {{ h.intro.text | paras | safe }}
      {% if h.intro.accent %}<p class="accent">{{ h.intro.accent }}</p>{% endif %}
    </div>
  </div>
</section>

{# ---------- CORE ---------- #}
<section class="split split-img-left" id="core">
  <div class="split-media"><img src="{{ h.core.image }}" alt="{{ h.core.image_alt }}" loading="lazy"></div>
  <div class="split-text">
    <p class="eyebrow">{{ h.core.eyebrow }}</p>
    <h2>{{ h.core.title | lines | safe }}</h2>
    {{ h.core.text | paras | safe }}
    {% if h.core.button_text %}<a class="btn" href="{{ h.core.button_link or settings.contact_link }}">{{ h.core.button_text }} {% include "arrow.njk" %}</a>{% endif %}
  </div>
</section>

{# ---------- ÜBER MICH ---------- #}
<section class="split split-img-right" id="ueber-mich">
  <div class="split-media"><img src="{{ h.about.image }}" alt="{{ h.about.image_alt }}" loading="lazy"></div>
  <div class="split-text">
    <p class="eyebrow">{{ h.about.eyebrow }}</p>
    <h2>{{ h.about.title | lines | safe }}</h2>
    {{ h.about.text | paras | safe }}
    {% if h.about.button_text %}<a class="btn btn-outline" href="{{ h.about.button_link or settings.contact_link }}">{{ h.about.button_text }} {% include "arrow.njk" %}</a>{% endif %}
  </div>
</section>

{# ---------- SESSIONS ---------- #}
<section class="sessions" id="sessions">
  <div class="wrap">
    <p class="eyebrow">{{ h.sessions.eyebrow }}</p>
    <h2>{{ h.sessions.title | lines | safe }}</h2>
    <div class="features">
      {% for item in h.sessions.items %}
      <div class="feature">
        {% set name = item.icon %}{% include "icon.njk" %}
        <p>{{ item.text | lines | safe }}</p>
      </div>
      {% endfor %}
      <div class="feature feature-cta">
        <a class="btn" href="{{ settings.contact_link }}">{{ h.sessions.button_text }} {% include "arrow.njk" %}</a>
      </div>
    </div>
  </div>
</section>

{# ---------- ERFAHRUNGEN ---------- #}
{% if h.testimonials.items.length %}
<section class="testimonials">
  <div class="testimonials-media"><img src="{{ h.testimonials.image }}" alt="{{ h.testimonials.image_alt }}" loading="lazy"></div>
  <div class="testimonials-body">
    <p class="eyebrow">{{ h.testimonials.eyebrow }}</p>
    <div class="quotes" tabindex="0" aria-label="Erfahrungsberichte">
      {% for t in h.testimonials.items %}
      <figure class="quote">
        <blockquote>„{{ t.quote }}“</blockquote>
        {% if t.name %}<figcaption>– {{ t.name }}</figcaption>{% endif %}
      </figure>
      {% endfor %}
    </div>
    <div class="dots" aria-hidden="true"></div>
  </div>
</section>
{% endif %}

{# ---------- ABSCHLUSS ---------- #}
<section class="cta">
  <div class="cta-media"><img src="{{ h.cta.image }}" alt="{{ h.cta.image_alt }}" loading="lazy"></div>
  <div class="wrap cta-content">
    <p class="cta-title">{{ h.cta.title | lines | safe }}</p>
    <a class="btn" href="{{ settings.contact_link }}">{{ h.cta.button_text }} {% include "arrow.njk" %}</a>
  </div>
</section>

{# ---------- KONTAKT ---------- #}
{% if h.contact.show %}
<section class="contact" id="kontakt">
  <div class="wrap narrow contact-inner">
    <p class="eyebrow">{{ h.contact.eyebrow }}</p>
    <h2>{{ h.contact.title | lines | safe }}</h2>
    {{ h.contact.text | paras | safe }}
    <div class="contact-actions">
      {% if settings.contact_email %}<a class="btn" href="mailto:{{ settings.contact_email }}?subject={{ h.contact.mail_subject | urlencode }}">{{ h.contact.button_text }} {% include "arrow.njk" %}</a>{% endif %}
      {% if settings.phone %}<a class="btn btn-outline" href="tel:{{ settings.phone | replace(' ', '') }}">{{ settings.phone }}</a>{% endif %}
    </div>
    {% if settings.contact_email %}<p class="contact-mail">{{ settings.contact_email }}</p>{% endif %}
  </div>
</section>
{% endif %}
