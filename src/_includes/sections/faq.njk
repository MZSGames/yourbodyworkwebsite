{# ---------- HÄUFIGE FRAGEN (ein-/ausschaltbar) ---------- #}
{% if sessions.faq_show and sessions.faq.length %}
<section class="faq">
  <div class="wrap narrow">
    {% if sessions.faq_eyebrow %}<p class="eyebrow">{{ sessions.faq_eyebrow }}</p>{% endif %}
    {% if sessions.faq_title %}<h2>{{ sessions.faq_title | lines | safe }}</h2>{% endif %}
    <div class="faq-list">
      {% for q in sessions.faq %}
      <details class="faq-item">
        <summary>{{ q.question }}</summary>
        <div class="faq-answer">{{ q.answer | paras | safe }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
