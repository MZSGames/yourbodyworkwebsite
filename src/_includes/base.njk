<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} – {{ settings.logo_name }}{% else %}{{ settings.site_title }}{% endif %}</title>
  <meta name="description" content="{{ settings.meta_description }}">
  <meta property="og:title" content="{{ settings.site_title }}">
  <meta property="og:description" content="{{ settings.meta_description }}">
  <meta property="og:image" content="{{ settings.share_image }}">
  <link rel="preload" href="/fonts/cormorant-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="{{ bodyClass }}">
  <header class="site-header" id="top">
    <div class="wrap header-inner">
      <a class="logo" href="/">
        <span class="logo-name">{{ settings.logo_name }}</span>
        <span class="logo-sub">{{ settings.logo_subtitle }}</span>
      </a>
      <button class="nav-toggle" aria-label="Menü öffnen" aria-expanded="false"><span></span><span></span><span></span></button>
      <nav class="main-nav" aria-label="Hauptnavigation">
        <a href="/#top" class="is-active">Start</a>
        <a href="/#core">CORE® Bodywork</a>
        <a href="/#ueber-mich">Über mich</a>
        <a href="/#sessions">1:1 Sessions</a>
        <a href="/#kontakt">Kontakt</a>
        <a class="btn btn-small" href="{{ settings.contact_link }}">{{ settings.header_button_text }} {% include "arrow.njk" %}</a>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <a class="logo logo-light" href="/">
        <span class="logo-name">{{ settings.logo_name }}</span>
        <span class="logo-sub">{{ settings.logo_subtitle }}</span>
      </a>
      <nav class="footer-nav" aria-label="Rechtliches">
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutzerklärung</a>
        <a href="/feedback/">Feedback</a>
      </nav>
      {% if settings.instagram_url %}
      <a class="insta" href="{{ settings.instagram_url }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1" class="fill"/></svg>
        <span><small>{{ settings.instagram_label }}</small>{{ settings.instagram_handle }}</span>
      </a>
      {% endif %}
    </div>
  </footer>
  <script src="/js/main.js" defer></script>
</body>
</html>
