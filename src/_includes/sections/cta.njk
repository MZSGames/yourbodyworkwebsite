{# ---------- ABSCHLUSS ----------
   Bild: eigenes Bild der Seite (pd.cta_image), sonst das gemeinsame Bild #}
{% set ctaImg = (pd.cta_image if pd and pd.cta_image else cta.image) %}
{% set ctaAlt = (pd.cta_image_alt if pd and pd.cta_image else cta.image_alt) %}
{% set ctaFocus = (pd.cta_image_focus if pd and pd.cta_image else cta.image_focus) %}
<section class="cta{% if not ctaImg %} no-image{% endif %}">
  {% if ctaImg %}<div class="cta-media"><img src="{{ ctaImg }}" alt="{{ ctaAlt }}" style="{{ ctaFocus | focus('60% 40%') }}" loading="lazy"></div>{% endif %}
  <div class="wrap cta-content">
    <p class="cta-title">{{ cta.title | lines | safe }}</p>
    <a class="btn" href="{{ settings.contact_link | link }}">{{ cta.button_text }} {% include "arrow.njk" %}</a>
  </div>
</section>
