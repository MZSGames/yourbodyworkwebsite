---
layout: base.njk
title: Feedback
bodyClass: page
---
{% set f = feedback %}
<section class="page-body feedback-page">
  <div class="wrap narrow">
    <p class="eyebrow">{{ f.eyebrow }}</p>
    <h1>{{ f.title | lines | safe }}</h1>
    <div class="feedback-intro">{{ f.intro | paras | safe }}</div>

    {% if settings.feedback_key %}
    <form class="feedback-form" action="https://api.web3forms.com/submit" method="POST" data-feedback>
      <input type="hidden" name="access_key" value="{{ settings.feedback_key }}">
      <input type="hidden" name="subject" value="Neues Feedback über deine Website">
      <input type="hidden" name="from_name" value="Website-Feedback">
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off">

      <label>{{ f.message_label }}
        <textarea name="Feedback" rows="7" required placeholder="{{ f.message_placeholder }}"></textarea>
      </label>
      <label>{{ f.name_label }}
        <input name="Name" autocomplete="off">
      </label>
      <fieldset class="consent">
        <legend>{{ f.consent_title }}</legend>
        <label class="check"><input type="radio" name="Veröffentlichung" value="{{ f.consent_no }}" checked><span>{{ f.consent_no }}</span></label>
        <label class="check"><input type="radio" name="Veröffentlichung" value="{{ f.consent_anon }}"><span>{{ f.consent_anon }}</span></label>
        <label class="check"><input type="radio" name="Veröffentlichung" value="{{ f.consent_name }}"><span>{{ f.consent_name }}</span></label>
      </fieldset>
      <button class="btn" type="submit">{{ f.button_text }} {% include "arrow.njk" %}</button>
      <p class="form-error" hidden>{{ f.error_text }}</p>
    </form>

    <div class="feedback-success" hidden>
      <h2>{{ f.success_title }}</h2>
      {{ f.success_text | paras | safe }}
      <p><a class="btn btn-outline" href="/">Zur Startseite {% include "arrow.njk" %}</a></p>
    </div>
    {% else %}
    <p class="feedback-not-ready">{{ f.not_ready_text }}</p>
    {% endif %}
  </div>
</section>
