{# Kacheln auf der Startseite, die zu den Unterseiten führen #}
<section class="teasers">
  <div class="wrap teaser-grid">
    {% for t in [
      { d: core, url: "/core-bodywork/" },
      { d: about, url: "/ueber-mich/" },
      { d: sessions, url: "/sessions/" },
      { d: workshops, url: "/workshops/", hide: not workshops.show }
    ] %}{% if not t.hide %}
    <a class="teaser" href="{{ t.url }}">
      {% set timg = t.d.image or start.hero.image %}
      {% if timg %}<div class="teaser-img"><img src="{{ timg }}" alt="" style="{{ (t.d.image_focus if t.d.image else start.hero.image_focus) | focus }}" loading="lazy"></div>{% endif %}
      <p class="eyebrow">{{ t.d.menu_label }}</p>
      <p class="teaser-title">{{ t.d.title | lines | safe }}</p>
      <span class="teaser-more">Mehr erfahren {% include "arrow.njk" %}</span>
    </a>
    {% endif %}{% endfor %}
  </div>
</section>
