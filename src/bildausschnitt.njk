layout: base.njk
title: Bildausschnitt finden
bodyClass: page tool
permalink: /bildausschnitt/
noindex: true
---
{# Optionale Hilfsseite: zeigt per Klick, welche der 9 Positionen im Editor-Feld
   «Bildausschnitt» gewählt werden sollte. Eingestellt wird immer in Pages CMS.
   Die Seite ist nicht im Menü verlinkt und für Suchmaschinen gesperrt. #}
<section class="page-body tool-page">
  <div class="wrap">
    <p class="eyebrow">Hilfe zum Bildausschnitt</p>
    <h1>Welchen Bildausschnitt wählen?</h1>
    <p class="tool-intro">Eingestellt wird der Bildausschnitt immer im Editor (Pages CMS) im Feld <strong>«Bildausschnitt»</strong>. Diese Seite hilft dir nur dabei, die passende Position zu finden: Klick ins Bild, und du siehst, was du im Editor auswählen solltest und wie es aussehen wird.</p>

    <div class="tool-step">
      <h2><span>1</span> Bild auswählen</h2>
      <p>Klick auf eines deiner Website-Bilder, oder wähle ein Foto von deinem Gerät aus.</p>
      <div class="tool-thumbs">
        {% for img in uploads %}
        <button type="button" class="tool-thumb" title="{{ img | replace('/images/uploads/', '') }}"><img src="{{ img }}" alt="" loading="lazy"></button>
        {% endfor %}
      </div>
      <label class="btn btn-outline tool-file">Foto vom Gerät wählen <input type="file" accept="image/*" hidden></label>
      <p class="tool-hint">Ein Foto vom Gerät wird nur hier angezeigt und nirgends hochgeladen.</p>
    </div>

    <div class="tool-step" data-needs-image hidden>
      <h2><span>2</span> Ins Bild klicken</h2>
      <p>Klick auf die Stelle, die <strong>immer sichtbar</strong> bleiben soll, z. B. das Gesicht. Das Bild ist dafür in 9 Felder aufgeteilt, genau wie die Auswahl im Editor.</p>
      <div class="tool-stage">
        <img class="tool-main" alt="Ausgewähltes Bild">
        <div class="tool-grid" aria-hidden="true">{% for i in range(9) %}<span></span>{% endfor %}</div>
      </div>
    </div>

    <div class="tool-step tool-result" data-needs-image hidden>
      <h2><span>3</span> Im Editor auswählen</h2>
      <p>Wähle in Pages CMS beim passenden Bild im Feld <strong>«Bildausschnitt»</strong>:</p>
      <p class="tool-choice" data-choice>● Mitte (Standard)</p>
      <p>Dann <strong>Speichern</strong>. Nach 1–2 Minuten ist es auf deiner Website sichtbar.</p>
    </div>

    <div class="tool-step" data-needs-image hidden>
      <h2><span>4</span> Vorschau</h2>
      <p>So ungefähr wird das Bild mit dieser Auswahl an den verschiedenen Stellen zugeschnitten.</p>
      <div class="tool-previews">
        <figure><div class="pv" style="aspect-ratio: 6 / 5"><img alt=""></div><figcaption>Grosses Bild ganz oben (Computer)</figcaption></figure>
        <figure><div class="pv" style="aspect-ratio: 4 / 3"><img alt=""></div><figcaption>Bild neben Text &amp; Kacheln (Computer)</figcaption></figure>
        <figure><div class="pv" style="aspect-ratio: 3 / 2"><img alt=""></div><figcaption>Erfahrungsberichte (Computer)</figcaption></figure>
        <figure><div class="pv" style="aspect-ratio: 16 / 9"><img alt=""></div><figcaption>Am Handy &amp; Abschluss-Bereich</figcaption></figure>
      </div>
    </div>
  </div>
</section>

<style>
  .tool-intro { color: var(--ink-soft); max-width: 720px; }
  .tool-step { margin-top: 48px; }
  .tool-step h2 { font-size: clamp(24px, 2.4vw, 32px); display: flex; align-items: center; gap: 14px; }
  .tool-step h2 span { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--clay); color: #fff; font: 500 16px var(--sans); }
  .tool-step p { color: var(--ink-soft); }
  .tool-thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; margin: 18px 0; }
  .tool-thumb { padding: 0; border: 2px solid transparent; border-radius: calc(var(--radius) * .6); overflow: hidden; cursor: pointer; aspect-ratio: 1; background: var(--sand); }
  .tool-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .tool-thumb.is-active { border-color: var(--clay); }
  .tool-file { cursor: pointer; }
  .tool-hint { font-size: 14px; }
  .tool-stage { position: relative; display: inline-block; max-width: 100%; margin-top: 10px; cursor: pointer; user-select: none; }
  .tool-main { display: block; max-width: 100%; max-height: 70vh; border-radius: calc(var(--radius) * .6); }
  .tool-grid { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); border-radius: calc(var(--radius) * .6); overflow: hidden; pointer-events: none; }
  .tool-grid span { border: 1px solid rgba(255,255,255,.55); transition: background .2s; }
  .tool-grid span.is-active { background: color-mix(in srgb, var(--clay) 40%, transparent); box-shadow: inset 0 0 0 3px #fff; }
  .tool-choice { display: inline-block; font: 500 26px var(--sans); color: var(--ink) !important; padding: 12px 24px; background: var(--cream-2); border: 1px solid var(--sand); border-radius: calc(var(--radius) * .6); margin: 4px 0 8px; }
  .tool-previews { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 18px; align-items: end; }
  .tool-previews figure { margin: 0; }
  .tool-previews .pv { overflow: hidden; border-radius: calc(var(--radius) * .6); background: var(--sand); }
  .tool-previews img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tool-previews figcaption { font-size: 14px; color: var(--ink-soft); margin-top: 8px; }
  @media (max-width: 980px) { .tool-previews { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .tool-previews { grid-template-columns: 1fr; } }
</style>

<script>
(() => {
  // Dieselben 9 Positionen wie im Editor-Feld «Bildausschnitt»
  const ROWS = [["oben", "15%"], ["mitte", "50%"], ["unten", "85%"]];
  const COLS = [["links", "15%"], ["mitte", "50%"], ["rechts", "85%"]];
  const LABELS = {
    "oben-links": "↖ Oben links", "oben-mitte": "↑ Oben", "oben-rechts": "↗ Oben rechts",
    "mitte-links": "← Links", "mitte-mitte": "● Mitte (Standard)", "mitte-rechts": "→ Rechts",
    "unten-links": "↙ Unten links", "unten-mitte": "↓ Unten", "unten-rechts": "↘ Unten rechts",
  };

  const main = document.querySelector(".tool-main");
  const stage = document.querySelector(".tool-stage");
  const cells = document.querySelectorAll(".tool-grid span");
  const previews = document.querySelectorAll(".tool-previews img");
  const choice = document.querySelector("[data-choice]");

  const select = (row, col) => {
    cells.forEach((c, i) => c.classList.toggle("is-active", i === row * 3 + col));
    const pos = `${COLS[col][1]} ${ROWS[row][1]}`;
    previews.forEach((p) => (p.style.objectPosition = pos));
    choice.textContent = LABELS[`${ROWS[row][0]}-${COLS[col][0]}`];
  };

  const show = (src) => {
    main.src = src;
    previews.forEach((p) => (p.src = src));
    document.querySelectorAll("[data-needs-image]").forEach((el) => (el.hidden = false));
    select(1, 1);
    stage.scrollIntoView({ behavior: "smooth", block: "center" });
  };

  document.querySelectorAll(".tool-thumb").forEach((b) =>
    b.addEventListener("click", () => {
      document.querySelectorAll(".tool-thumb").forEach((t) => t.classList.remove("is-active"));
      b.classList.add("is-active");
      show(b.querySelector("img").src);
    })
  );

  document.querySelector(".tool-file input").addEventListener("change", (e) => {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    document.querySelectorAll(".tool-thumb").forEach((t) => t.classList.remove("is-active"));
    show(URL.createObjectURL(file));
  });

  stage.addEventListener("click", (e) => {
    const r = main.getBoundingClientRect();
    const col = Math.min(2, Math.max(0, Math.floor(((e.clientX - r.left) / r.width) * 3)));
    const row = Math.min(2, Math.max(0, Math.floor(((e.clientY - r.top) / r.height) * 3)));
    select(row, col);
  });
})();
</script>
